{
  "extends": "@ember/library-tsconfig",
  "include": ["src", "tests"],
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["ember-source/types", "@glint/ember-tsc/types", "vite/client"]
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [".gts", ".gjs"]
    }
  ]
}
